tion: relative;margin-bottom: 28px}\n\n    .timeline-item:last-child {margin-bottom: 0}\n\n    .timeline-item::before {content: \"\";position: absolute;left: -35px;top: 4px;width: 12px;height: 12px;border-radius: 50%;background: var(--wine-main);border: 2px solid var(--bg-card)}\n\n    .timeline-step {font-family: monospace;font-size: 12px;color: var(--wine-light);font-weight: 700}\n\n    .timeline-title {font-size: 18px;color: var(--wine-deep);font-weight: 700;margin: 2px 0 6px 0}\n\n    .timeline-detail {font-size: 14px;color: var(--text-muted)}\n\n    /* 票据卡片通用构件 */\n    .section-title-wrap {margin-bottom: 20px;border-bottom: 2px solid var(--wine-deep);padding-bottom: 8px;display: flex;justify-content: space-between;align-items: baseline}\n\n    h2 {font-size: 22px;color: var(--wine-deep);font-weight: 700}\n\n    .section-ref {font-family: monospace;font-size: 13px;color: var(--wine-border)}\n\n    .receipt-card {background: var(--bg-card);border: var(--line-dashed);padding: 24px;position: relative;margin-bottom: 24px}\n\n    .perforation {border-top: 1px dashed var(--wine-border);margin: 18px 0;position: relative}\n\n    /* 套餐：阶梯式递进排列 */\n    .plans-staircase {display: grid;grid-template-columns: repeat(3, 1fr);gap: 20px;align-items: end;margin-top: 40px;margin-bottom: 48px}\n\n    .plan-step-card {background: var(--bg-card);border: var(--line-dashed);padding: 24px 20px;position: relative;display: flex;flex-direction: column}\n\n    .plan-step-1 {min-height: 400px}\n\n    .plan-step-2 {min-height: 450px;border: 2px solid var(--wine-deep);background: #fff}\n\n    .plan-step-3 {min-height: 500px;background: #fdf8f9}\n\n    .step-tag {font-family: monospace;font-size: 12px;color: var(--wine-light);margin-bottom: 4px}\n\n    .plan-name {font-size: 20px;color: var(--wine-deep);font-weight: 800}\n\n    .plan-price-block {margin: 14px 0}\n\n    .plan-price {font-size: 28px;font-weight: 800;color: var(--wine-main);font-family: monospace}\n\n    .plan-period {font-size: 14px;color: var(--text-muted)}\n\n    .plan-annual {font-size: 13px;color: var(--wine-light);margin-top: 4px;font-family: monospace}\n\n    .plan-checklist {list-style: none;margin: 16px 0;font-size: 13.5px;flex-grow: 1}\n\n    .plan-checklist li {padding: 5px 0;border-bottom: 1px dashed #edd5db;display: flex;align-items: flex-start;gap: 6px}\n\n    .plan-checklist li::before {content: \"[x]\";font-family: monospace;font-size: 12px;color: var(--wine-main)}\n\n    .plan-action {margin-top: 14px;text-align: center}\n\n    .btn-receipt {display: inline-block;width: 100%;padding: 10px 0;text-align: center;text-decoration: none;font-size: 14px;font-weight: 700;border: 1px solid var(--wine-deep);color: var(--wine-deep);background: #fff}\n\n    .btn-receipt:hover {background: var(--wine-deep);color: #fff}\n\n    .btn-featured {background: var(--wine-deep);color: #fff}\n\n    .btn-featured:hover {background: var(--wine-main)}\n\n    /* 客户端与参数清单 */\n    .clients-grid {display: grid;grid-template-columns: repeat(2, 1fr);gap: 20px;margin-bottom: 48px}\n\n    .client-item {background: var(--bg-card);border: var(--line-dashed);padding: 20px}\n\n    .client-head {display: flex;justify-content: space-between;border-bottom: 1px dashed var(--wine-border);padding-bottom: 8px;margin-bottom: 12px}\n\n    .client-os {font-weight: 700;color: var(--wine-deep);font-size: 16px}\n\n    .client-status {font-family: monospace;font-size: 12px;background: var(--wine-faint);color: var(--wine-main);padding: 2px 6px;border: 1px solid var(--wine-border)}\n\n    .checklist-plain {list-style: none;font-size: 13.5px;color: var(--text-muted)}\n\n    .checklist-plain li {margin-bottom: 6px;padding-left: 16px;position: relative}\n\n    .checklist-plain li::before {content: \"-\";position: absolute;left: 0;color: var(--wine-main);font-weight: 700}\n\n    /* FAQ：按主题分组展示 */\n    .faq-wrapper {margin-bottom: 48px}\n\n    .faq-group {margin-bottom: 24px;border: var(--line-dashed);background: var(--bg-card);padding: 24px}\n\n    .faq-group-title {font-size: 16px;color: #fff;background: var(--wine-deep);display: inline-block;padding: 4px 12px;margin-bottom: 16px;font-weight: 700;letter-spacing: 0.5px}\n\n    .faq-item {border-bottom: 1px dashed #edd5db;padding: 14px 0}\n\n    .faq-item:last-child {border-bottom: none;padding-bottom: 0}\n\n    .faq-question {font-size: 15px;font-weight: 700;color: var(--wine-deep);margin-bottom: 6px;display: flex;align-items: baseline;gap: 6px}\n\n    .faq-question::before {content: \"Q:\";font-family: monospace;color: var(--wine-light)}\n\n    .faq-answer {font-size: 14px;color: var(--text-muted);padding-left: 24px;line-height: 1.6}\n\n    /* 页脚信息票据 */\n    footer {border-top: 2px dashed var(--wine-border);padding-top: 24px;margin-top: 32px;font-size: 13px;color: var(--text-muted);display: flex;flex-wrap: wrap;justify-content: space-between;gap: 16px}\n\n    .footer-note {max-width: 600px}\n\n    .footer-meta {font-family: monospace;text-align: right}\n\n    @media (max-width: 860px) {\n      .plans-staircase {grid-template-columns: 1fr;align-items: stretch}\n      .plan-step-1, .plan-step-2, .plan-step-3 {min-height: auto}\n      .clients-grid {grid-template-columns: 1fr}\n      footer {flex-direction: column}\n      .footer-meta {text-align: left}\n    }\n  </style><main>\n  \n  <aside class=\"jump-strip\" aria-label=\"页面导览\">\n    <span class=\"jump-strip-title\">Allegro 节点目录索引</span>\n    <nav class=\"jump-links\">\n      <a href=\"#timeline-hero\">接入流程</a>\n      <a href=\"#plans-section\">阶梯配置方案</a>\n      <a href=\"#clients-section\">终端部署清单</a>\n      <a href=\"#faq-section\">主题问答库</a>\n    </nav>\n  </aside>\n\n  \n  <section id=\"timeline-hero\" class=\"hero-timeline-box\">\n    <div class=\"brand-tag\">ALLEGRO PROTOCOL MANIFEST</div>\n    <h1>Allegro 网络中继交付与运行审计清单</h1>\n    <p class=\"lead-paragraph\">本清单列出 Allegro 服务自建档至多终端联机的完整执行时序。无隐晦修辞，各项节点配额、分流规则与设备并发上限均按参数如实执行。</p>\n\n    <div class=\"timeline\">\n      <article class=\"timeline-item\">\n        <div class=\"timeline-step\">PHASE 01 / 规划与准入</div>\n        <h3 class=\"timeline-title\">测算用量基线与设备并发池</h3>\n        <p class=\"timeline-detail\">核实日常流量开销及同时在线终端数量。基础流量段为 100GB/月，多机协同环境需对应 5 台或 20 台设备并发配额，避免超出阈值被系统断开连接。</p>\n      </article>\n\n      <article class=\"timeline-item\">\n        <div class=\"timeline-step\">PHASE 02 / 订阅下发与协议核对</div>\n        <h3 class=\"timeline-title\">生成标准化订阅链接与节点密钥</h3>\n        <p class=\"timeline-detail\">系统提供符合行业标准的核心配置文件，明确标注普通节点池、原生解锁链路与 IPLC 专线路由，节点属性公开展示，杜绝混淆标签。</p>\n      </article>\n\n      <article class=\"timeline-item\">\n        <div class=\"timeline-step\">PHASE 03 / 客户端环境部署</div>\n        <h3 class=\"timeline-title\">导入通用内核并完成规则分流</h3>\n        <p class=\"timeline-detail\">不强制绑定专用客户端。用户可按操作系统指引导入支持标准协议的开源或主流应用，完成 GEOIP 规则库更新与直连白名单预设。</p>\n      </article>\n\n      <article class=\"timeline-item\">\n        <div class=\"timeline-step\">PHASE 04 / 持续状态监测与运维支持</div>\n        <h3 class=\"timeline-title\">流量周期重置与工单响应</h3>\n        <p class=\"timeline-detail\">每月固定周期清零已用计量。期间如遇骨干网抖动或流媒体解锁策略更新，按不同订阅级别通过控制台工单或专属服务渠道处置。</p>\n      </article>\n    </div>\n  </section>\n\n  \n  <section id=\"plans-section\">\n    <div class=\"section-title-wrap\">\n      <h2>服务阶梯配额凭据</h2>\n      <span class=\"section-ref\">TABLE // PLAN_TIERS</span>\n    </div>\n\n    <div class=\"plans-staircase\">\n      \n      <article class=\"plan-step-card plan-step-1\">\n        <span class=\"step-tag\">TIER 01 / 基础个人型</span>\n        <h3 class=\"plan-name\">基础版</h3>\n        <div class=\"plan-price-block\">\n          <span class=\"plan-price\">¥15</span>\n          <span class=\"plan-period\">/月</span>\n          <div class=\"plan-annual\">按年付仅需 ¥150/年</div>\n        </div>\n        <div class=\"perforation\"></div>\n        <ul class=\"plan-checklist\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n          <li>工单系统常规响应</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"btn-receipt\">核对并选择该方案</a>\n        </div>\n      </article>\n\n      \n      <article class=\"plan-step-card plan-step-2\">\n        <span class=\"step-tag\">TIER 02 / 主力推荐型</span>\n        <h3 class=\"plan-name\">旗舰版</h3>\n        <div class=\"plan-price-block\">\n          <span class=\"plan-price\">¥35</span>\n          <span class=\"plan-period\">/月</span>\n          <div class=\"plan-annual\">按年付仅需 ¥350/年</div>\n        </div>\n        <div class=\"perforation\"></div>\n        <ul class=\"plan-checklist\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n          <li>高优先级突发带宽调度</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"btn-receipt btn-featured\">核对并选择该方案</a>\n        </div>\n      </article>\n\n      \n      <article class=\"plan-step-card plan-step-3\">\n        <span class=\"step-tag\">TIER 03 / 多设备集群型</span>\n        <h3 class=\"plan-name\">团队版</h3>\n        <div class=\"plan-price-block\">\n          <span class=\"plan-price\">¥85</span>\n          <span class=\"plan-period\">/月</span>\n          <div class=\"plan-annual\">按年付仅需 ¥850/年</div>\n        </div>\n        <div class=\"perforation\"></div>\n        <ul class=\"plan-checklist\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n          <li>多 IP 并发容错池</li>\n          <li>独立监控告警通道</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"btn-receipt\">核对并选择该方案</a>\n        </div>\n      </article>\n    </div>\n  </section>\n\n  \n  <section id=\"clients-section\">\n    <div class=\"section-title-wrap\">\n      <h2>终端环境与协议装配清单</h2>\n      <span class=\"section-ref\">CHECKLIST // CLIENT_SETUP</span>\n    </div>\n\n    <div class=\"clients-grid\">\n      <article class=\"client-item\">\n        <div class=\"client-head\">\n          <span class=\"client-os\">Windows 操作系统</span>\n          <span class=\"client-status\">通用内核配置</span>\n        </div>\n        <ul class=\"checklist-plain\">\n          <li>兼容 Clash / Sing-box / v2rayN 等通用客户端内核。</li>\n          <li>通过控制台复制标准 Subscription URL 并写入本地配置源。</li>\n          <li>建议将系统代理模式设为“规则模式”，避免本地局域网地址受阻。</li>\n          <li>开启 TUN 虚拟网卡模式前，需以管理员权限运行对应程序。</li>\n        </ul>\n      </article>\n\n      <article class=\"client-item\">\n        <div class=\"client-head\">\n          <span class=\"client-os\">macOS 操作系统</span>\n          <span class=\"client-status\">通用内核配置</span>\n        </div>\n        <ul class=\"checklist-plain\">\n          <li>适配 Clash Verge / Surge / Sing-box 等 macOS 架构客户端。</li>\n          <li>从 Allegro 仪表盘获取兼容格式配置，支持手动粘贴或远程拉取。</li>\n          <li>针对 Apple 基础服务建议配置专用直连规则，减少证书警告。</li>\n          <li>系统网络扩展若弹出提示，需在“隐私与安全性”中放行权限。</li>\n        </ul>\n      </article>\n\n      <article class=\"client-item\">\n        <div class=\"client-head\">\n          <span class=\"client-os\">iOS / iPadOS 移动终端</span>\n          <span class=\"client-status\">第三方工具导入</span>\n        </div>\n        <ul class=\"checklist-plain\">\n          <li>支持使用 Shadowrocket、Loon、Quantumult X 或 Stash 配合使用。</li>\n          <li>打开相机扫描仪表盘提供的二维码订阅凭证，自动完成节点列表加载。</li>\n          <li>可设置定时自动更新策略（建议每 24 小时更新一次节点参数）。</li>\n          <li>Wi-Fi 与蜂窝数据切换时，若发生连接悬挂请轻触飞行模式刷新。</li>\n        </ul>\n      </article>\n\n      <article class=\"client-item\">\n        <div class=\"client-head\">\n          <span class=\"client-os\">Android &amp; Linux 平台</span>\n          <span class=\"client-status\">开源协议适配</span>\n        </div>\n        <ul class=\"checklist-plain\">\n          <li>Android 设备建议使用 Clash Meta 或 v2rayNG，支持国内白名单直连。</li>\n          <li>Linux 命令行环境支持以 systemd 托管后台核心进程与代理环境变量。</li>\n          <li>支持通过基础 Cron 任务自动拉取 Allegro 节点配置清单。</li>\n          <li>配置完成后需使用 curl 验证出口 IP 归属地与连通延迟。</li>\n        </ul>\n      </article>\n    </div>\n  </section>\n\n  \n  <section id=\"faq-section\" class=\"faq-wrapper\">\n    <div class=\"section-title-wrap\">\n      <h2>常见问题与运维规格说明</h2>\n      <span class=\"section-ref\">GROUPED // FAQ_DATABASE</span>\n    </div>\n\n    \n    <div class=\"faq-group\">\n      <div class=\"faq-group-title\">主题 01：订阅生效、配额与账单</div>\n      \n      <div class=\"faq-item\">\n        <h3 class=\"faq-question\">流量计算是以自然月为周期还是以付款日为周期？</h3>\n        <div class=\"faq-answer\">\n          Allegro 计费系统的用量重置以账单生成日（即购买日）为锚点。例如在某月 15 日开通，则在次月 15 日自动重置可用流量配额，非自然月 1 日统一清空。\n        </div>\n      </div>\n\n      <div class=\"faq-item\">\n        <h3 class=\"faq-question\">如果当月流量耗尽，服务会如何响应？</h3>\n        <div class=\"faq-answer\">\n          当月配额（100GB、300GB 或 1000GB）用尽后，节点中继端口将停止响应请求。用户可在仪表盘中提前查看用量进度条，或根据需要升级至更高级别的阶梯方案。\n        </div>\n      </div>\n\n      <div class=\"faq-item\">\n        <h3 class=\"faq-question\">同时在线设备数超额会产生什么后果？</h3>\n        <div class=\"faq-answer\">\n          系统以活跃 TCP/UDP 会话并发 IP 进行校验。若设备超出对应方案许可（如基础版 3 台、旗舰版 5 台），新发起的连接请求将被限流或暂时排队，直至旧设备断开会话。\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"faq-group\">\n      <div class=\"faq-group-title\">主题 02：线路差异、流媒体与路由调优</div>\n      \n      <div class=\"faq-item\">\n        <h3 class=\"faq-question\">“普通线路节点池”与“IPLC 专线游戏加速优化”有何技术区别？</h3>\n        <div class=\"faq-answer\">\n          基础版的普通线路走公共公网骨干互联，在跨国路由高峰时段可能受国际出口拥堵影响；旗舰版及以上的 IPLC 链路使用内网专线进行物理点对点跨越，绕过公网阻断节点，具有固定的抖动区间。\n        </div>\n      </div>\n\n      <div class=\"faq-item\">\n        <h3 class=\"faq-question\">什么是全节点原生流媒体解锁？</h3>\n        <div class=\"faq-answer\">\n          指节点出口 IP 注册在对应地区本土机房或本地运营商段内，非广播 IP。流媒体平台将其识别为合规本土访问，降低解析失败与代理拦截标记概率。\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"faq-group\">\n      <div class=\"faq-group-title\">主题 03：网络诊断与故障处理</div>\n      \n      <div class=\"faq-item\">\n        <h3 class=\"faq-question\">节点出现完全无法联通时应优先排查哪些项？</h3>\n        <div class=\"faq-answer\">\n          请依次按清单执行排查：① 本机系统时间是否与标准北京时间同步（误差超出 60 秒会导致握手失败）；② 客户端订阅是否超过 48 小时未刷新；③ 本地防火墙或安全软件是否拦截了代理内核进程。\n        </div>\n      </div>\n\n      <div class=\"faq-item\">\n        <h3 class=\"faq-question\">不同方案的工单支持响应时限有何差异？</h3>\n        <div class=\"faq-answer\">\n          基础版用户提交工单按队列在常规工作时段（09:00 - 18:00）处理；旗舰版提供 7x24 小时高优先工单轮转；团队版享有独立专员即时联络通道与定制路由排错服务。\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer>\n    <div class=\"footer-note\">\n      <strong>Allegro 接入规范声明：</strong> 本站所展示技术参数、设备并发限额与月度流量指标均由后台统一审计下发。用户接入时应遵守各地区法律法规，不得用于未授权的网络渗透测试或高负载滥用行为。\n    </div>\n    <div class=\"footer-meta\">\n      <div>ORG: ALLEGRO-NETWORK</div>\n      <div>SEED_ID: 8237 // STYLED</div>\n      <div>STATUS: VERIFIED_STATIC</div>\n    </div>\n  </footer>\n</main>",
